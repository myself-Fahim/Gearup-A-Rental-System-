enum Role {
    CUSTOMER
    PROVIDER
    ADMIN
}

enum User_status {
    suspend
    activate
}

model User {
    id         String      @id @default(uuid())
    name       String
    email      String      @unique
    password   String
    role       Role        @default(CUSTOMER)
    status     User_status @default(activate)
    image_url  String?
    created_At DateTime    @default(now())
    updated_At DateTime    @updatedAt

    gears   Gear[]
    orders  Order[]
    reviews Review[]
}
