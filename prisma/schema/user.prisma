enum Role {
    CUSTOMER
    PROVIDER
    ADMIN
}

model User {
    id String @id @default(uuid())
    name String
    email String @unique
    password String
    role   Role @default(CUSTOMER)
    image_url String?
    created_At DateTime @default(now())
    updated_At DateTime @updatedAt

    gears Gear[]
    orders Order[]
    reviews Review[]
}