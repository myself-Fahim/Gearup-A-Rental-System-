model Review {
    id        String   @id @default(uuid())
    user_id   String
    gear_id   String
    rating    Int
    comment   String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [user_id], references: [id])
    gear Gear @relation(fields: [gear_id], references: [id],onDelete: Cascade)
}
